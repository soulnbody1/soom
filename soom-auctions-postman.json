{
  "info": {
    "name": "Soom Auctions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "List Auctions",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions"
          }
        },
        {
          "name": "Show Auction",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions/{{auction_id}}"
          }
        },
        {
          "name": "List Auction Bids",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions/{{auction_id}}/bids"
          }
        },
        {
          "name": "Payment Methods",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/soom/payment-methods"
          }
        },
        {
          "name": "Auction Terms",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/soom/auction-terms"
          }
        }
      ]
    },
    {
      "name": "Seller",
      "item": [
        {
          "name": "Create Auction",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "title", "value": "iPhone 15 Pro Max", "type": "text"},
                {"key": "description", "value": "Excellent condition.", "type": "text"},
                {"key": "category_id", "value": "1", "type": "text"},
                {"key": "country_id", "value": "1", "type": "text"},
                {"key": "currency_code", "value": "JOD", "type": "text"},
                {"key": "starting_amount", "value": "100.000", "type": "text"},
                {"key": "minimum_bid_increment", "value": "1.000", "type": "text"},
                {"key": "seller_deposit_amount", "value": "10.000", "type": "text"},
                {"key": "bidder_deposit_amount", "value": "5.000", "type": "text"},
                {"key": "starts_at", "value": "2026-07-12 10:00:00", "type": "text"},
                {"key": "ends_at", "value": "2026-07-13 10:00:00", "type": "text"},
                {"key": "media[]", "type": "file", "src": "/path/to/image.jpg"}
              ]
            }
          }
        },
        {
          "name": "Submit For Review",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/submit-review"
          }
        },
        {
          "name": "Submit Seller Deposit",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/seller-deposit",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "payment_method_id", "value": "{{payment_method_id}}", "type": "text", "description": "Payment method public_id"},
                {"key": "idempotency_key", "value": "seller-deposit-{{$timestamp}}", "type": "text"},
                {"key": "receipt", "type": "file", "src": "/path/to/receipt.jpg"}
              ]
            }
          }
        },
        {
          "name": "Confirm Handover",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/confirm-handover"
          }
        },
        {
          "name": "Open Handover Dispute",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/disputes",
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"handover issue\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        }
      ]
    },
    {
      "name": "Bidder",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/register"
          }
        },
        {
          "name": "Accept Terms",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/accept-terms"
          }
        },
        {
          "name": "Submit Bidder Deposit",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/bidder-deposit",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "payment_method_id", "value": "{{payment_method_id}}", "type": "text", "description": "Payment method public_id"},
                {"key": "idempotency_key", "value": "bidder-deposit-{{$timestamp}}", "type": "text"},
                {"key": "receipt", "type": "file", "src": "/path/to/receipt.jpg"}
              ]
            }
          }
        },
        {
          "name": "Place Bid",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/bids",
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":\"110.000\",\"currency_code\":\"JOD\",\"idempotency_key\":\"bid-{{$timestamp}}\",\"client_request_id\":\"postman-{{$timestamp}}\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Submit Winner Payment",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/winner-payment",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "payment_method_id", "value": "{{payment_method_id}}", "type": "text", "description": "Payment method public_id"},
                {"key": "idempotency_key", "value": "winner-payment-{{$timestamp}}", "type": "text"},
                {"key": "receipt", "type": "file", "src": "/path/to/receipt.jpg"}
              ]
            }
          }
        },
        {
          "name": "Confirm Receipt",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/confirm-receipt"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "All Auctions",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions"
          }
        },
        {
          "name": "Review Auction",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/api/admin/auctions/{{auction_id}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\"action\":\"approve\",\"reason\":\"approved\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Payment Submissions",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions/payment-submissions"
          }
        },
        {
          "name": "Temporary Receipt URL",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions/payment-submissions/{{payment_submission_id}}/receipt-url"
          }
        },
        {
          "name": "Review Payment Submission",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/api/admin/auctions/payment-submissions/{{payment_submission_id}}/review",
            "body": {
              "mode": "raw",
              "raw": "{\"action\":\"approve\",\"note\":\"receipt verified\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Resolve Handover Dispute",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/api/admin/auctions/{{auction_id}}/disputes/{{dispute_id}}/resolve",
            "body": {
              "mode": "raw",
              "raw": "{\"resolution\":\"resume_handover\",\"note\":\"resolved by admin\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Mark Winner Defaulted",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{admin_token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "url": "{{base_url}}/api/admin/auctions/{{auction_id}}/winner-default",
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"payment deadline missed\",\"reassign_to_next\":true}",
              "options": {"raw": {"language": "json"}}
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000"},
    {"key": "auth_token", "value": ""},
    {"key": "admin_token", "value": ""},
    {"key": "auction_id", "value": "01J00000000000000000000000"},
    {"key": "payment_method_id", "value": "01J00000000000000000000000"},
    {"key": "payment_submission_id", "value": "01J00000000000000000000000"},
    {"key": "dispute_id", "value": "01J00000000000000000000000"}
  ]
}
