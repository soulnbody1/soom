{
  "info": {
    "name": "Soom Auctions API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"phone\":\"{{phone}}\",\"password\":\"{{password}}\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{name}}\",\"phone\":\"{{phone}}\",\"password\":\"{{password}}\",\"password_confirmation\":\"{{password}}\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        }
      ]
    },
    {
      "name": "2. Public Auctions (No Auth)",
      "item": [
        {
          "name": "List Active Auctions",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions?page=1"
          }
        },
        {
          "name": "Get Auction Details (record view)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions/{{auction_id}}"
          }
        },
        {
          "name": "Get Auction Bids",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions/{{auction_id}}/bids"
          }
        },
        {
          "name": "Get Highest Bid",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/auctions/{{auction_id}}/highest-bid"
          }
        }
      ]
    },
    {
      "name": "3. My Auctions (Auth Required)",
      "item": [
        {
          "name": "Create Auction (FormData)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "title", "value": "iPhone 15 Pro Max", "type": "text"},
                {"key": "description", "value": "iPhone 15 Pro Max 256GB بحالة ممتازة مع الكرتون وكل الملحقات الأصلية. استخدام شهر واحد فقط.", "type": "text"},
                {"key": "category_id", "value": "2", "type": "text"},
                {"key": "country_id", "value": "1", "type": "text"},
                {"key": "state_id", "value": "3", "type": "text"},
                {"key": "city_id", "value": "7", "type": "text"},
                {"key": "starting_price", "value": "3500", "type": "text"},
                {"key": "min_accept_price", "value": "3000", "type": "text"},
                {"key": "starts_at", "value": "", "type": "text", "description": "Optional - leave empty for current time"},
                {"key": "duration_days", "value": "7", "type": "text"},
                {"key": "terms_accepted", "value": "true", "type": "text"},
                {"key": "images[]", "type": "file", "src": "/path/to/image1.jpg"},
                {"key": "images[]", "type": "file", "src": "/path/to/image2.jpg"}
              ]
            }
          }
        },
        {
          "name": "My Auctions",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/my/auctions"
          }
        },
        {
          "name": "Update Auction",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Updated Title\",\"description\":\"Updated description\",\"starting_price\":4000,\"min_accept_price\":3500,\"starts_at\":\"2026-05-15 10:00:00\",\"duration_days\":10}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Get Auction Details (with Bids)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}"
          }
        },
        {
          "name": "Cancel Auction",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/cancel"
          }
        },
        {
          "name": "Close Auction",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/close"
          }
        },
        {
          "name": "Pay Advertiser Deposit (FormData - Image Upload)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/pay-deposit",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "payment_method_id", "value": "1", "type": "text", "description": "ID من جدول payment_methods"},
                {"key": "image", "type": "file", "src": "/path/to/payment_slip.jpg", "description": "صورة إيصال الدفع"},
                {"key": "amount", "value": "", "type": "text", "description": "اختياري - لو فاضي هياخد deposit_amount من المزاد"}
              ]
            }
          }
        },
        {
          "name": "Admin: Set Auction Deposit Values",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/set-deposit",
            "body": {
              "mode": "raw",
              "raw": "{\"deposit_type\":\"fixed\",\"deposit_fixed_amount\":500,\"deposit_percentage\":null}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: All Auctions (All Statuses)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/all",
            "description": "الأدمن فقط - بجيب كل المزادات بكل حالاتها"
          }
        }
      ]
    },
    {
      "name": "4. Bidding (Auth Required)",
      "item": [
        {
          "name": "Get Deposit Info",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/deposit-info"
          }
        },
        {
          "name": "Pay Bidder Deposit (FormData - Image Upload)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/pay-bid-deposit",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "payment_method_id", "value": "1", "type": "text", "description": "ID من جدول payment_methods"},
                {"key": "image", "type": "file", "src": "/path/to/payment_slip.jpg", "description": "صورة إيصال الدفع"},
                {"key": "amount", "value": "", "type": "text", "description": "اختياري - لو فاضي هياخد deposit_amount من المزاد"}
              ]
            }
          }
        },
        {
          "name": "Place Bid",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":3600,\"deposit_transaction_id\":\"txn_123\",\"terms_accepted\":true}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Increase Bid (رفع المزايدة)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/bid",
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":550,\"terms_accepted\":true}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "My Bids",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/my/bids"
          }
        }
      ]
    },
    {
      "name": "5. Auction Deposits (New - Unified Table)",
      "item": [
        {
          "name": "Get Advertiser Deposit Details",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/deposit-info",
            "description": "بيرجع تفاصيل التأمين الخاص بالمزاد (advertiser) والمزايد (bidder)"
          }
        },
        {
          "name": "Get Bidder Deposit for my bid",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/my/bids",
            "description": "بيرجع كل مزايداتي مع تفاصيل التأمين (deposit_paid, deposit_status, deposit_status_label)"
          }
        },
        {
          "name": "List All Deposits for Auction (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/auctions/{{auction_id}}/payment-slips",
            "description": "بيرجع كل إيصالات الدفع (payment_slips) المرتبطة بالمزاد - سواء كانت للمعلن أو للمزايدين"
          }
        }
      ]
    },
    {
      "name": "6. Public: Settings (No Auth)",
      "item": [
        {
          "name": "List Auction Rules",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/soom/auction-rules"
          }
        },
        {
          "name": "Get Auction Rule Details",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/soom/auction-rules/{{rule_id}}"
          }
        },
        {
          "name": "List Payment Methods",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/soom/payment-methods"
          }
        },
        {
          "name": "Get Payment Method Details",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": "{{base_url}}/api/soom/payment-methods/{{payment_method_id}}"
          }
        }
      ]
    },
    {
      "name": "7. Admin: Settings (Auth Required - Admin)",
      "item": [
        {
          "name": "Admin: List Auction Rules",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-rules"
          }
        },
        {
          "name": "Admin: Create Auction Rule",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-rules",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"الحد الأدنى للزيادة هو 1 جنيه\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: Update Auction Rule",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-rules/{{rule_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"الشروط المحدثة للمزادات\"}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: Delete Auction Rule",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-rules/{{rule_id}}"
          }
        },
        {
          "name": "Admin: List Payment Methods",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/payment-methods"
          }
        },
        {
          "name": "Admin: Create Payment Method",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/payment-methods",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"بطاقة ائتمان\",\"is_active\":true}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: Update Payment Method",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/payment-methods/{{payment_method_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"تحويل بنكي\",\"is_active\":true}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: Delete Payment Method",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/payment-methods/{{payment_method_id}}"
          }
        },
        {
          "name": "Admin: List Auctions Configurations",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions-configurations"
          }
        },
        {
          "name": "Admin: Create Auctions Configuration",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions-configurations",
            "body": {
              "mode": "raw",
              "raw": "{\"deposit_type\":\"percentage\",\"amount\":10,\"category_id\":null,\"duration_days\":7,\"start_date\":null,\"end_date\":null}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: Update Auctions Configuration",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions-configurations/{{config_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"deposit_type\":\"fixed\",\"amount\":500,\"category_id\":null,\"duration_days\":10}",
              "options": {"raw": {"language": "json"}}
            }
          }
        },
        {
          "name": "Admin: Delete Auctions Configuration",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auctions-configurations/{{config_id}}"
          }
        }
      ]
    },
    {
      "name": "8. Payment Slips (Auth Required)",
      "item": [
        {
          "name": "Upload Payment Slip (FormData)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/payment-slips",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "image", "type": "file", "src": "/path/to/slip.jpg", "description": "صورة الإيصال"},
                {"key": "payment_method_id", "value": "1", "type": "text"},
                {"key": "amount", "value": "500", "type": "text"},
                {"key": "payable_type", "value": "auction", "type": "text", "description": "auction أو bid"},
                {"key": "payable_id", "value": "1", "type": "text"}
              ]
            }
          }
        },
        {
          "name": "Get Payment Slips for Auction",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/auctions/{{auction_id}}/payment-slips"
          }
        },
        {
          "name": "Get Payment Slips for Bid",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/bids/{{bid_id}}/payment-slips"
          }
        }
      ]
    },
    {
      "name": "9. Auction Deposits - Admin Approval (Auth Required - Admin)",
      "item": [
        {
          "name": "Admin: List All Deposits",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-deposits?type=advertiser&verified=no"
          }
        },
        {
          "name": "Admin: Get Deposit Details",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-deposits/{{deposit_id}}"
          }
        },
        {
          "name": "Admin: PROCESS Deposit (Verify or Reject)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-deposits/{{deposit_id}}/process",
            "body": {
              "mode": "raw",
              "raw": "{\"action\":\"verified\"}",
              "options": {"raw": {"language": "json"}}
            },
            "description": "✔️ `verified` يوافق → المزاد ينشط | ❌ `rejected` يرفض"
          }
        },
        {
          "name": "Admin: Get Deposits for Auction",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/admin/auction-deposits/by-auction/{{auction_id}}"
          }
        }
      ]
    },
    {
      "name": "10. My Deposits (Auth Required - User)",
      "item": [
        {
          "name": "My Deposits",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/my/deposits",
            "description": "بيرجع كل تأمينات المستخدم الحالي"
          }
        }
      ]
    },
    {
      "name": "11. Notifications (Auth Required)",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/notifications"
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/notifications/mark-all-as-read"
          }
        },
        {
          "name": "Mark Single as Read",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Accept", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{auth_token}}"}
            ],
            "url": "{{base_url}}/api/soom/notifications/{{notification_id}}/read"
          }
        }
      ]
